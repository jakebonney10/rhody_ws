[submodule "src/nucleus_driver"]
	path = src/nucleus_driver
	url = https://github.com/jakebonney10/nucleus_driver.git
	# feature/streaming_only, not the default jazzy-devel: the pinned commit
	# (f8bde36) is what adds the configurable TCP port and listen-only mode
	# that rhody-nucleus.service depends on, and it is not merged to
	# jazzy-devel. Without this, submodule update --remote would silently
	# move the pin back and break listen-only mode.
	branch = feature/streaming_only
[submodule "src/project11/project11_msgs"]
	path = src/project11/project11_msgs
	url = https://github.com/rolker/project11_msgs.git
[submodule "src/project11/project11"]
	path = src/project11/project11
	url = https://github.com/rolker/project11.git
[submodule "src/project11/mru_transform"]
	path = src/project11/mru_transform
	url = https://github.com/SeawardScience/mru_transform.git
[submodule "src/rhody"]
	path = src/rhody
	url = https://github.com/jakebonney10/rhody.git
[submodule "src/acoustic_msgs_tools"]
	path = src/acoustic_msgs_tools
	url = https://github.com/k2oceanic/acoustic_msgs_tools.git
[submodule "src/gemini_sonar_driver"]
	path = src/gemini_sonar_driver
	url = https://github.com/jakebonney10/gemini_sonar_driver.git
[submodule "src/adnav_driver"]
	path = src/adnav_driver
	url = https://github.com/jakebonney10/adnav_driver.git
[submodule "src/voyis_discovery_driver"]
	path = src/voyis_discovery_driver
	url = https://github.com/jakebonney10/voyis_discovery_driver.git
[submodule "src/reach_robotics"]
	path = src/reach_robotics
	url = https://github.com/jakebonney10/reach_robotics.git
[submodule "src/rviz_sonar_image"]
	path = src/rviz_sonar_image
	url = https://github.com/jakebonney10/rviz_sonar_image.git
[submodule "src/fls_sonar_proc"]
	path = src/fls_sonar_proc
	url = https://github.com/jakebonney10/fls_sonar_proc.git
[submodule "src/marine_colormap"]
	path = src/marine_colormap
	url = https://github.com/rolker/marine_colormap.git
[submodule "src/sprintnav_driver"]
	path = src/sprintnav_driver
	url = https://github.com/jakebonney10/sprintnav_driver.git
[submodule "src/hydroport"]
	path = src/hydroport
	url = https://github.com/SeawardScience/hydroport.git
	# devel, not the default master: master is the upstream package
	# template and contains no hydroport package at all.
	branch = devel
